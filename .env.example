# Copy to .env (npm run dev does this automatically the first time). No real keys belong in this file.

# --- Database -------------------------------------------------------------
# SQLite locally. For production switch the provider in prisma/schema.prisma to "postgresql"
# and put the Supabase/Postgres connection string here.
DATABASE_URL="file:./dev.db"

# --- App ------------------------------------------------------------------
# Public address of the app. Used in WhatsApp messages and booking links when the
# request host is not available.
APP_URL="http://localhost:3000"
# Shown instead of the host in "your link" boxes, e.g. termini.app (leave empty to show the real host).
PUBLIC_LINK_HOST=""
# Random string (32+ characters), used to hash IP addresses and login codes. The app refuses to run in
# production with this default value.
APP_SECRET="dev-secret-change-me"
# "1" shows the login code on screen and logs it (no SMS provider yet). Ignored in production
# (NODE_ENV=production never shows codes unless DEMO_SHOW_CODES_IN_PRODUCTION="1", for a private demo only).
SHOW_LOGIN_CODES="1"
# Phone numbers (E.164, comma separated) that get the admin role when they log in.
ADMIN_PHONES="+38349000000"
# WhatsApp number of Termini support, digits only (shown on payment and help screens).
SUPPORT_WHATSAPP="38349000000"
SUPPORT_NAME="Termini"

# --- AI (Faqja Gati) --------------------------------------------------------
# Optional. Without a key the page content is built by the local deterministic filler.
ANTHROPIC_API_KEY=""
AI_MODEL_FILL="claude-haiku-5-5"
AI_MODEL_RETRY="claude-sonnet-5-5"

# --- Payments ----------------------------------------------------------------
# Paysera checkout (https://developers.paysera.com/en/checkout/basic). Empty = Paysera card is shown as "së shpejti".
PAYSERA_PROJECT_ID=""
PAYSERA_SIGN_PASSWORD=""
PAYSERA_TEST="1"
# Bank transfer details shown on the payment screen.
BANK_IBAN="XK05 0000 0000 0000 0000"
BANK_NAME="Banka (vendos emrin)"
BANK_HOLDER=""
PAGE_PRICE_CENTS="10000"

# --- Reminders ---------------------------------------------------------------
# "link" = WhatsApp click-to-chat links (free). Later: "whatsapp_api" or "sms".
REMINDER_CHANNEL="link"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SMS_API_KEY=""

# Paysera public key (PEM, 
 for newlines) from https://www.paysera.com/download/public.key. Required in production.
PAYSERA_PUBLIC_KEY=""
# Max Faqja Gati AI generations per day across all users.
FG_DAILY_CAP="200"

# Second lock for /admin (after the SMS code). Set with: npm run admin:password. Required in production.
ADMIN_PASSWORD_HASH=""
