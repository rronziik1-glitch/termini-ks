{
  "name": "termini-faqja-gati",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-setup.mjs",
    "dev": "next dev",
    "build": "node scripts/ensure-setup.mjs && next build",
    "vercel-build": "node scripts/ensure-setup.mjs && next build",
    "start": "next start",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:pg-schema": "node scripts/db-migrate.mjs --schema-only",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node scripts/test-db.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "admin:password": "node scripts/admin-password.mjs",
    "env:check": "node scripts/env-check.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.9.0",
    "ajv": "^8.17.1",
    "jsdom": "^25.0.1",
    "next": "^15.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
