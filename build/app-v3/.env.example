# ==============================================================================
#  Termini + Faqja Gati: every setting of the app, with a short explanation.
#
#  On your computer:  this file is copied to .env automatically the first time
#                     you run "npm run dev". The values below work as they are.
#  Online (Vercel):   you do NOT upload this file. You paste each value in
#                     Vercel → Project → Settings → Environment Variables.
#                     GO-ONLINE.md says where to get every value.
#
#  NEVER put real keys in this file (it is part of the code). Real keys go only
#  in .env on your computer or in Vercel.
#  Lines starting with # are comments. [REQUIRED ONLINE] = the app refuses to
#  start in production without it. Check everything with:  npm run env:check
# ==============================================================================


# --- 1. Database ---------------------------------------------------------------
# Local: a SQLite file, nothing to install.
# Online [REQUIRED ONLINE]: the PostgreSQL address from Neon or Supabase. It starts
# with postgresql:// . The app sees that and switches to PostgreSQL by itself.
DATABASE_URL="file:./dev.db"
# Online only: the "direct" (not pooled) PostgreSQL address, used when the tables
# are created or updated. Leave empty to use DATABASE_URL for that too.
DIRECT_URL=""
# Set to "1" to build without touching the database (rarely needed).
SKIP_DB_MIGRATE=""
# Set to "1" to also add the 3 example businesses to a PostgreSQL database.
SEED_DEMO=""


# --- 2. The app's address --------------------------------------------------------
# [REQUIRED ONLINE] The public address, with https:// and no slash at the end.
# Example online: https://termini.app
APP_URL="http://localhost:3000"
# Shown in "your link" boxes instead of the address, e.g. termini.app
# (leave empty to show the real address).
PUBLIC_LINK_HOST=""
# Domain for Faqja Gati pages. When set, a page lives at  name.<this domain>
# (example: faqjagati.com → berberi-arti.faqjagati.com). The domain needs a
# wildcard record (*.faqjagati.com) pointing to Vercel. Leave empty and pages
# live at  APP_URL/p/name  (this always keeps working too).
PAGES_DOMAIN=""
# [REQUIRED ONLINE] A long random text (32+ characters). It protects logins.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="dev-secret-change-me"


# --- 3. Private launch -----------------------------------------------------------
# When this has a value, the WHOLE site asks for this password first (so you can
# test online before anyone else sees it). Empty = the site is open to everyone.
# The Paysera payment callback keeps working while the password is on.
SITE_PASSWORD=""


# --- 4. Login codes (the 6-digit code owners get when they log in) -----------------
# Who delivers the code:
#   dev       nobody: the code is shown on the screen (your computer only)
#   sms       an SMS company (Twilio, Infobip or another gateway)
#   whatsapp  WhatsApp Cloud API (Meta)
# [REQUIRED ONLINE] must be sms or whatsapp.
OTP_PROVIDER="dev"
# The message text. {code} becomes the code. Keep it short and without ë/ç
# (those make an SMS cost double).
OTP_TEXT="Kodi yt per Termini: {code}. Vlen 10 minuta."
# Only for OTP_PROVIDER="dev" on your computer: "1" shows the code on screen.
SHOW_LOGIN_CODES="1"
# DANGER. "1" shows login codes on screen even online, so anyone can log in as
# anyone. Only for a private demo behind SITE_PASSWORD. Never with real customers.
DEMO_SHOW_CODES_IN_PRODUCTION=""

# -- 4a. SMS (only when OTP_PROVIDER="sms") --
# Which company's format: twilio, infobip or generic.
SMS_STYLE="generic"
# The sender name or number people see (max 11 letters for a name).
SMS_FROM="Termini"
# The secret key. Twilio: "Auth Token". Infobip: "API key".
SMS_API_KEY=""
# Twilio only: the "Account SID".
SMS_ACCOUNT_ID=""
# Infobip: your personal base URL, e.g. https://abc123.api.infobip.com
# Generic: the full address the message is sent to.
SMS_API_URL=""
# Generic only. Words in {curly brackets} are filled in by the app:
# {to} = 38349123456   {to_plus} = +38349123456   {text}   {from}   {code}   {key} = SMS_API_KEY
SMS_API_METHOD="POST"
SMS_API_HEADERS='{"Authorization":"Bearer {key}"}'
SMS_API_BODY='{"to":"{to_plus}","from":"{from}","text":"{text}"}'

# -- 4b. WhatsApp (only when OTP_PROVIDER="whatsapp") --
# From Meta for Developers → your app → WhatsApp → API Setup.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Name and language of your approved "Authentication" message template.
WHATSAPP_OTP_TEMPLATE="login_code"
WHATSAPP_OTP_LANG="sq"
WHATSAPP_API_VERSION="v21.0"


# --- 5. Admin ----------------------------------------------------------------------
# Phone numbers that become admin when they log in (with +383, comma between them).
ADMIN_PHONES="+38349000000"
# Second lock for /admin. Make it with:  npm run admin:password
# and paste the long line it prints. Without it /admin stays closed online.
ADMIN_PASSWORD_HASH=""
# WhatsApp number of Termini support, digits only, and the name shown with it.
SUPPORT_WHATSAPP="38349000000"
SUPPORT_NAME="Termini"


# --- 6. Photos (where uploaded photos are kept) -------------------------------------
#   local        a folder on this computer (your computer only)
#   vercel-blob  Vercel Blob (easiest with Vercel)
#   supabase     Supabase Storage
#   s3           Cloudflare R2, Backblaze B2, Amazon S3 or similar
# [REQUIRED ONLINE] must not be "local" on Vercel.
STORAGE_DRIVER="local"
# vercel-blob: Vercel fills this in by itself when you create a Blob store.
BLOB_READ_WRITE_TOKEN=""
# supabase: Project URL, the "service_role" key, and the name of a PRIVATE bucket.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
STORAGE_BUCKET="faqja-gati"
# s3: the values from your storage company. Region "auto" is right for Cloudflare R2.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""


# --- 7. Payments -------------------------------------------------------------------
# Price of a Faqja Gati page in cents (10000 = 100 €).
PAGE_PRICE_CENTS="10000"
# Bank transfer details shown on the payment screen.
BANK_IBAN="XK05 0000 0000 0000 0000"
BANK_NAME="Banka (vendos emrin)"
BANK_HOLDER=""
# Paysera (card payments). Leave all three empty and the card option shows
# "së shpejti"; bank transfer and cash still work.
# From Paysera → Projects and Activities → your project → Project settings.
PAYSERA_PROJECT_ID=""
PAYSERA_SIGN_PASSWORD=""
# Paysera's public key: open https://www.paysera.com/download/public.key , copy
# everything, and paste it as ONE line with \n where each line ended.
PAYSERA_PUBLIC_KEY=""
# Paysera checks that the website is yours. It gives you a short code
# ("verify-paysera"); paste only the code here and the app shows it to Paysera.
PAYSERA_VERIFY_CODE=""
# "1" = test payments (no real money). Set to "0" on launch day.
PAYSERA_TEST="1"
# Language of the Paysera payment page (ENG, LIT, RUS, …).
PAYSERA_LANG="ENG"
# Address of Paysera's payment page. Do not change unless Paysera tells you to.
PAYSERA_PAY_URL="https://www.paysera.com/pay/"


# --- 8. AI (the texts of Faqja Gati pages) -------------------------------------------
# Key from https://console.anthropic.com . Empty = pages are filled by the simple
# built-in writer (free, works offline, less polished).
ANTHROPIC_API_KEY=""
AI_MODEL_FILL="claude-haiku-5-5"
AI_MODEL_RETRY="claude-sonnet-5-5"
# Safety limit: the most pages the AI may write per day, for all users together.
FG_DAILY_CAP="200"


# --- 9. Reminders ---------------------------------------------------------------------
# "link" = WhatsApp click-to-chat links (free). Automatic reminders come later.
REMINDER_CHANNEL="link"


# --- 10. Technical (normally leave as they are) -----------------------------------------
# How much is written to the log: debug, info, warn or error.
LOG_LEVEL="info"
# Your computer only: lets "npm start" run even when online settings are missing.
# Ignored on Vercel.
SKIP_ENV_CHECK=""
