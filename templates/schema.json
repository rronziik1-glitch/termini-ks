{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faqjagati.com/schema/content-v1.json",
  "title": "Faqja Gati page content v1",
  "description": "One shape for all six templates. Every template reads the same fields; a template simply skips a section whose data is empty. Strings are Albanian. Empty string or empty array means 'not provided'. Links (WhatsApp, tel, map, booking) are derived by fg.js from contact/location/booking, never stored here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "brand", "hero", "services", "location", "contact", "booking"],
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "description": "URL or path. Empty string = show the template's tonal placeholder. The AI always leaves this empty; the server assigns uploads." },
        "alt": { "type": "string", "description": "Short Albanian description of the photo (also used as the brief for the photo to shoot or generate)." }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template"],
      "properties": {
        "template": { "type": "string", "enum": ["berber", "klinike-dentare", "restorant-kafe", "bujtine", "salon-bukurie", "dyqan"] },
        "lang": { "type": "string", "default": "sq" },
        "title": { "type": "string", "description": "Browser/Google title, max 60 characters. Example: 'Berberi Arti · Berber në Gjakovë'." },
        "description": { "type": "string", "description": "Google description, max 155 characters." }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": { "type": "string", "description": "Hex colour like #C8A46A, or empty string to keep the template default.", "pattern": "^(#[0-9a-fA-F]{6})?$" },
        "variant": { "type": "string", "enum": ["", "a", "b", "c"], "description": "Optional colour variant defined by the template's CSS ([data-variant])." }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "Business name as on the sign." },
        "category": { "type": "string", "description": "Shown label, e.g. 'Berber', 'Klinikë dentare'." },
        "city": { "type": "string" },
        "since": { "type": "string", "description": "Founding year if the owner gave it, e.g. '2015'." }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "eyebrow": { "type": "string", "description": "Small line above the title, e.g. 'Berber · Gjakovë'." },
        "title": { "type": "string", "description": "Max 6 words, no full stop." },
        "subtitle": { "type": "string", "description": "One sentence, max 18 words." },
        "image": { "$ref": "#/$defs/image" },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "src": { "type": "string", "description": "MP4 URL for a muted looping hero video (top package). Empty = use the image." },
            "poster": { "type": "string" }
          }
        }
      }
    },
    "highlights": {
      "type": "array",
      "maxItems": 4,
      "description": "Short facts given by the owner. Example: {value:'10', label:'vjet përvojë'}. Omit if none were given.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "text": { "type": "string", "description": "2 to 4 sentences, max 70 words." },
        "points": { "type": "array", "maxItems": 6, "items": { "type": "string" }, "description": "Short facts or amenities, e.g. 'Parking falas', 'Wi-Fi', 'Pa termin për fëmijë'." },
        "image": { "$ref": "#/$defs/image" }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups"],
      "description": "Services with prices. For restorant-kafe these are menu sections; for bujtine the rooms; for dyqan the products.",
      "properties": {
        "title": { "type": "string", "description": "Section title, e.g. 'Shërbimet', 'Menyja', 'Dhomat', 'Produktet'." },
        "intro": { "type": "string" },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["items"],
            "properties": {
              "name": { "type": "string", "description": "Group name; empty when there is only one group." },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 14,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string" },
                    "description": { "type": "string", "description": "Max 12 words." },
                    "price": { "type": "string", "description": "As shown: '5 €', 'nga 30 €', '45 € / natë'. Empty if not given." },
                    "duration": { "type": ["integer", "null"], "description": "Minutes, when it applies." },
                    "tag": { "type": "string", "description": "Optional small label: 'Më i kërkuari', 'E re'." },
                    "image": { "$ref": "#/$defs/image" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "gallery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "images": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/image" } }
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "description": "Only real reviews pasted by the owner. Never invented.",
      "properties": {
        "title": { "type": "string" },
        "rating": { "type": "string", "description": "Average as shown, e.g. '4.9'. Empty if unknown." },
        "count": { "type": "string", "description": "e.g. '128 vlerësime'. Empty if unknown." },
        "source": { "type": "string", "description": "e.g. 'Google'." },
        "items": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "text"],
            "properties": {
              "name": { "type": "string" },
              "text": { "type": "string" },
              "rating": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          }
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "members": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "image": { "$ref": "#/$defs/image" }
            }
          }
        }
      }
    },
    "faq": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["q", "a"],
        "properties": {
          "q": { "type": "string" },
          "a": { "type": "string" }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hours"],
      "properties": {
        "title": { "type": "string" },
        "address": { "type": "string", "description": "Street and landmark, e.g. 'Rr. Ismail Qemali 12, te Çarshia e Madhe'." },
        "city": { "type": "string" },
        "mapQuery": { "type": "string", "description": "Text for the map search/embed. Empty = address + city." },
        "note": { "type": "string", "description": "e.g. 'Parking përballë lokalit.'" },
        "hours": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["days", "time"],
            "properties": {
              "days": { "type": "string", "description": "'E hënë – E shtunë', 'E diel'." },
              "time": { "type": "string", "description": "'09:00 – 20:00' or 'Mbyllur'." }
            }
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phone"],
      "properties": {
        "phone": { "type": "string", "description": "International digits only, no plus: '38349123456'.", "pattern": "^[0-9]{8,15}$" },
        "phoneDisplay": { "type": "string", "description": "As locals write it: '049 123 456'." },
        "whatsapp": { "type": "string", "description": "Digits only. Empty = same as phone.", "pattern": "^([0-9]{8,15})?$" },
        "whatsappMessage": { "type": "string", "description": "Prefilled first message. Empty = default." },
        "email": { "type": "string" },
        "instagram": { "type": "string", "description": "Handle without @." },
        "facebook": { "type": "string", "description": "Page name or full URL." }
      }
    },
    "booking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean", "description": "true when the business has a Termini link. false = the booking button opens WhatsApp with a booking message." },
        "url": { "type": "string", "description": "Termini link, e.g. 'https://termini.app/berberi-arti'. Set by the server." },
        "label": { "type": "string", "description": "Button text. Default 'Rezervo termin'. bujtine: 'Rezervo qëndrimin'; restorant-kafe: 'Rezervo tavolinë'; dyqan: 'Porosit në WhatsApp'." }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string", "description": "Optional closing line." }
      }
    }
  }
}
